<tr>
  <td>
    <button type="button" class="reorder-row gm-screen-icon-button">
      <i class="fa fa-grip-lines"></i>
    </button>
  </td>
  <td>
    <input type="text" name="grids.{{gridId}}.name" value="{{grid.name}}" data-dtype="String">
  </td>
  <td>
    <input type="number" name="grids.{{gridId}}.columnOverride" placeholder="{{defaultColumns}}"
      value="{{grid.columnOverride}}" data-dtype="Number">
  </td>
  <td>
    <input type="number" name="grids.{{gridId}}.rowOverride" placeholder="{{defaultRows}}" value="{{grid.rowOverride}}"
      data-dtype="Number">
  </td>
  <td class="gms-scene-cell">
    <details class="gms-multi" data-grid-id="{{gridId}}">
      <summary>{{grid.sceneSummary}}</summary>
      <div class="gms-multi-list">
        <input type="search" class="gms-multi-filter" aria-label="{{localize 'GMSCR.gridConfig.scenePicker.Filter'}}">
        {{#each grid.sceneGroups as |group|}}
        <div class="gms-multi-group">
          {{#if group.folderName}}
          <div class="gms-multi-folder">{{group.folderName}}</div>
          {{/if}}
          {{#each group.scenes as |scene|}}
          <label>
            <input type="checkbox" name="grids.{{../../gridId}}.sceneIds" value="{{scene.id}}" {{#if scene.checked}}checked{{/if}}>
            <span>{{scene.name}}</span>
          </label>
          {{/each}}
        </div>
        {{/each}}
      </div>
    </details>
  </td>
  <td class="textCenter">
    <input type="checkbox" name="grids.{{gridId}}.isShared" {{#if grid.isShared}}checked{{/if}}>
  </td>
  <td class="textCenter">
    <input type="string" name="grids.{{gridId}}.id" value="{{gridId}}" data-dtype="String" class="hidden">

    <button type="button" title="{{localize 'Delete'}}" class='delete-row gm-screen-icon-button'>
      <i class="fa fa-trash"></i>
    </button>
  </td>
</tr>