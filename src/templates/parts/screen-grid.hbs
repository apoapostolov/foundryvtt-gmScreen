<div class="gm-screen-container tab {{grid.cssClass}}" data-tab="{{grid.id}}" data-group="gmScreen-primary">
  <div class="gm-screen-grid"
    style="grid-template-columns: repeat({{#if grid.columnOverride}}{{grid.columnOverride}}{{else}}{{@root/columns}}{{/if}}, {{#if @root/constrainCellContent}}minmax(0, 1fr){{else}}1fr{{/if}}); grid-template-rows: repeat({{#if grid.rowOverride}}{{grid.rowOverride}}{{else}}{{@root/rows}}{{/if}}, {{#if @root/constrainCellContent}}minmax(0, 1fr){{else}}1fr{{/if}});">

    {{#each gridEntries}}
    {{> 'modules/gm-screen/templates/parts/screen-cell.hbs' gridId=../grid.id}}
    {{/each}}
  </div>
</div>