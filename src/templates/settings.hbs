<div>

  <h2>{{localize 'GMSCR.gridConfig.GridTabs'}}</h2>

  <table>
    <colgroup>
      <col class="gms-col-order">
      <col class="gms-col-label">
      <col class="gms-col-num">
      <col class="gms-col-num">
      <col class="gms-col-scenes">
      <col class="gms-col-shared">
      <col class="gms-col-delete">
    </colgroup>
    <thead>
      <tr>
        <th>{{localize 'GMSCR.gridConfig.table.TabOrder'}}</th>
        <th>{{localize 'GMSCR.gridConfig.table.TabLabel'}}</th>
        <th>{{localize 'GMSCR.gridConfig.table.Columns'}}</th>
        <th>{{localize 'GMSCR.gridConfig.table.Rows'}}</th>
        <th>{{localize 'GMSCR.gridConfig.table.Scenes'}}</th>
        <th>{{localize 'GMSCR.gridConfig.table.Shared'}}</th>
        <th aria-label="{{localize 'Delete'}}"></th>
      </tr>
    </thead>

    <tbody>
      {{#each settings.grids as | grid id |}}
      {{> 'modules/gm-screen/templates/parts/settings-grid-config-table-row.hbs' gridId=id grid=grid
      defaultColumns=@root/defaultColumns
      defaultRows=@root/defaultRows}}
      {{/each}}
    </tbody>
  </table>

  <div class="flexrow gms-config-footer">
    <button type="button" data-table="grids" class="add-row">
      <i class="fa fa-plus"></i> <span>{{localize 'GMSCR.gridConfig.table.Add'}}</span>
    </button>

    <button type='submit'><i class="fa fa-save"></i> {{localize 'Save Changes'}}</button>
  </div>
</div>
